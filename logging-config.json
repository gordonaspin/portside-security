{
  "url": "https://github.com/mCodingLLC/VideosSampleCode/blob/master/videos/135_modern_logging/",
  "version": 1,
  "disable_existing_loggers": true,
  "formatters": {
    "production": {
      "format": "%(asctime)s.%(msecs)03d %(levelname)s %(message)s",
      "datefmt": "%Y-%m-%d %H:%M:%S"
    },
    "detailed": {
      "format": "%(asctime)s.%(msecs)03d %(levelname)s\t%(name)s:%(module)s.%(funcName)s.%(lineno)d\t%(message)s",
      "datefmt": "%Y-%m-%d %H:%M:%S"
    },
    "thread detailed": {
      "format": "%(asctime)s.%(msecs)03d %(levelname)s\t%(threadName)s\t%(name)s:%(module)s.%(funcName)s.%(lineno)d\t%(message)s",
      "datefmt": "%Y-%m-%d %H:%M:%S"
    }
  },
  "filters": {
    "KeywordFilter": {
      "()": "pynvr.logger.KeywordFilter"
    }
  },
  "handlers": {
    "stderr": {
      "class": "logging.StreamHandler",
      "level": "INFO",
      "formatter": "production",
      "stream": "ext://sys.stderr",
      "filters": ["KeywordFilter"]
    },
    "file": {
      "class": "logging.handlers.RotatingFileHandler",
      "level": "INFO",
      "formatter": "thread detailed",
      "filename": "logs/nvr.log",
      "maxBytes": 10000000,
      "backupCount": 3,
      "filters": ["KeywordFilter"]
    },
    "log_event_handler": {
      "class": "pynvr.logger.LogEventHandler",
      "level": "INFO",
      "formatter": "thread detailed",
      "filters": ["KeywordFilter"]
    }
  },
  "loggers": {
    "unhandled": {
      "level": "INFO",
      "handlers": [
        "stderr",
        "file"
      ]
    },
    "root": {
      "level": "INFO",
      "handlers": [
        "stderr", 
        "file",
        "log_event_handler"
      ]
    },
    "uvicorn.error": {
      "level": "CRITICAL",
      "handlers": [
        "stderr",
        "file"
      ],
      "propagate": false
    },
    "uvicorn.access": {
      "level": "ERROR",
      "handlers": [
        "stderr",
        "file"
      ],
      "propagate": false
    },
    "pynvr": {
      "level": "INFO",
      "handlers": [
        "stderr",
        "file",
        "log_event_handler"
      ],
      "propagate": false
    },
    "pynvr.cleaner": {
      "level": "INFO",
      "handlers": [
        "stderr",
        "file"
      ],
      "propagate": false
    },
    "pynvr.reader": {
      "level": "INFO",
      "handlers": [
        "stderr",
        "file",
        "log_event_handler"
      ],
      "propagate": false
    },
    "pynvr.recorder": {
      "level": "INFO",
      "handlers": [
        "stderr",
        "file",
        "log_event_handler"
      ],
      "propagate": false
    },
    "pynvr.processor": {
      "level": "INFO",
      "handlers": [
        "stderr",
        "file",
        "log_event_handler"
      ],
      "propagate": false
    },
    "pynvr.webrtc": {
      "level": "INFO",
      "handlers": [
        "stderr",
        "file"
      ],
      "propagate": false
    }
  }
}
